# Port the MCP server listens on
PORT=3000

# Bearer token the bMA must send as "Authorization: Bearer <token>"
# Generate with: openssl rand -hex 32
MCP_API_KEY=change-me

# Where created tickets are persisted between restarts (mock store)
TICKET_STORE_PATH=./data/mock/tickets.json

# Shared password for the incident board at /board (board is off if unset)
BOARD_PASSWORD=change-me-too
